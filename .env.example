NODE_ENV=production
PORT=8080

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/smart-study-assistant?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
COOKIE_MAX_AGE_MS=604800000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin (for CORS + cookies) - set to your production frontend URL
CLIENT_URL=https://ai-powereed-frontend.vercel.app
